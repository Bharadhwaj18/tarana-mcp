# Your Supabase project URL (Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co

# The anon (public) key is enough: every query is a SELECT and your
# row-level security policies decide what the signed-in user can see.
SUPABASE_ANON_KEY=your-anon-key

# Optional: a user access token if your RLS policies scope rows to
# auth.uid(). Without it the server reads whatever the `anon` role may see.
# Get one by signing in through your app and copying the session token -
# never commit a real token here.
SUPABASE_ACCESS_TOKEN=
