{
  "name": "tarana-mcp",
  "version": "1.0.0",
  "description": "Read-only MCP server for the Tarana Setlist Manager - lets AI assistants query a band's songs, setlists and shows stored in Supabase.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tarana-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@supabase/supabase-js": "^2.45.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  }
}
